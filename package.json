{
  "name": "zinga",
  "version": "0.2.0",
  "description": "Zinga - Un langage de programmation généraliste moderne avec syntaxe française et anglaise",
  "main": "dist/index.js",
  "bin": {
    "zinga": "./bin/zinga.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "tsc --noEmit",
    "dev": "ts-node src/index.ts",
    "zinga": "node bin/zinga.js"
  },
  "keywords": [
    "language",
    "compiler",
    "programming",
    "zinga",
    "french",
    "javascript",
    "webassembly",
    "llvm"
  ],
  "author": "Kinsmk",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "source-map": "^0.7.4",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/source-map": "*",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kinsmk/Zing.git"
  },
  "bugs": {
    "url": "https://github.com/Kinsmk/Zing/issues"
  },
  "homepage": "https://github.com/Kinsmk/Zing#readme"
}
